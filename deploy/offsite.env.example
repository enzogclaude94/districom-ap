# Off-site copy of the files that are not in PostgreSQL (imported files, nightly logical dumps), encrypted by
# rclone crypt. Copy to deploy/offsite.env; read only by the files-sync job. Never commit it.
# PENDING: provider and bucket (the same provider as repo2, another bucket or prefix).
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare   # or AWS, B2 (S3 API), Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=
# RCLONE_CONFIG_OFFSITE_REGION=auto
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITECRYPT_TYPE=crypt
# RCLONE_CONFIG_OFFSITECRYPT_REMOTE=offsite:<bucket>/files
# Obscured passwords (`rclone obscure`); deploy/bin/init-env generates them. Keep the clear ones off the server.
# RCLONE_CONFIG_OFFSITECRYPT_PASSWORD=
# RCLONE_CONFIG_OFFSITECRYPT_PASSWORD2=
