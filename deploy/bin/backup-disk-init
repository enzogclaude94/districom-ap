#!/usr/bin/env bash
# Prepares the backup disk once, after it is formatted and mounted at BACKUP_ROOT (/etc/fstab):
# checks that it is a mount point, writes the marker every backup script requires, and creates its folders.
# Refuses a folder that already holds backup folders without a marker: they may be on the system disk.
#   deploy/bin/backup-disk-init
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
# The marker also goes inside pgbackrest/, the only part of the disk the database container sees: its entry
# point refuses to start PostgreSQL without it (deploy/postgres/districom-entrypoint.sh).
inner_marker() {
    cp "$BACKUP_ROOT/$BACKUP_MARKER" "$BACKUP_ROOT/pgbackrest/$BACKUP_MARKER"
    chown 999:999 "$BACKUP_ROOT/pgbackrest/$BACKUP_MARKER"
}
if [ -f "$BACKUP_ROOT/$BACKUP_MARKER" ]; then
    [ -f "$BACKUP_ROOT/pgbackrest/$BACKUP_MARKER" ] || inner_marker
    log "backup disk already prepared: $BACKUP_ROOT ($(cat "$BACKUP_ROOT/$BACKUP_MARKER"))"
    exit 0
fi
if [ "${BACKUP_REQUIRE_MOUNTPOINT:-1}" != 0 ] && ! mountpoint -q "$BACKUP_ROOT"; then
    die "$BACKUP_ROOT is not a mount point: format and mount the backup disk first (docs/OPERATIONS.md)"
fi
for dir in pgbackrest dumps files state; do
    [ ! -e "$BACKUP_ROOT/$dir" ] || die "$BACKUP_ROOT/$dir exists without a marker: check what it is before preparing the disk"
done
echo "prepared=$(date -Is) host=$(hostname)" > "$BACKUP_ROOT/$BACKUP_MARKER"
for dir in pgbackrest dumps files state; do mkdir -p "$BACKUP_ROOT/$dir"; done
# pgbackrest/ and dumps/ belong to the postgres user of the db image (uid 999).
chown 999:999 "$BACKUP_ROOT/pgbackrest" "$BACKUP_ROOT/dumps"
chmod 750 "$BACKUP_ROOT/pgbackrest" "$BACKUP_ROOT/dumps"
inner_marker
log "backup disk prepared: $BACKUP_ROOT"
