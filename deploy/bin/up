#!/usr/bin/env bash
# First start, or start after a reboot of a stopped stack. Idempotent:
#   folders of the backup disk → images → database → pgBackRest stanza → migrations → app → first full backup.
#   deploy/bin/up [--no-build]
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
build=1
[ "${1:-}" = --no-build ] && build=0

# Backup disk layout. pgbackrest/ and dumps/ belong to the postgres user of the db image (uid 999).
for dir in pgbackrest dumps files state; do mkdir -p "$BACKUP_ROOT/$dir"; done
chown 999:999 "$BACKUP_ROOT/pgbackrest" "$BACKUP_ROOT/dumps"
chmod 750 "$BACKUP_ROOT/pgbackrest" "$BACKUP_ROOT/dumps"
[ -f "$ROOT/deploy/pgbackrest.env" ] || die "deploy/pgbackrest.env is missing: run deploy/bin/init-env"

[ "$build" -eq 1 ] && dc build
dc up -d db
wait_healthy db
# Creates the stanza in every repository, or checks it if it exists.
pgbr stanza-create
"$ROOT/deploy/bin/migrate"
# The uploads volume is created by Docker as root; the backend runs as uid 1001.
dc run --rm --no-deps -T -u root --entrypoint sh backend -c 'chown 1001 /data/uploads'
dc up -d --no-build
wait_healthy backend
pgbr check
if ! pgbr --repo=1 info --output=json | grep -q '"label"'; then
    "$ROOT/deploy/bin/backup" full first-backup
fi
"$ROOT/deploy/bin/smoke"
