# pgBackRest secrets and the off-site repository: copy to deploy/pgbackrest.env (deploy/bin/init-env generates
# the passphrases). Read only by the db container. Never commit it. Keep a copy of the passphrases OUTSIDE the
# server (company password manager + sealed envelope): without them no backup can be restored.

# repo1 (backup disk): encryption passphrase.
PGBACKREST_REPO1_CIPHER_PASS=

# repo2 (off-site, S3-compatible). PENDING: provider (Cloudflare R2, Backblaze B2 or AWS S3) and its bucket.
# Leave these lines commented until the bucket exists: with repo2 configured and unreachable, WAL queues locally.
# PGBACKREST_REPO2_TYPE=s3
# PGBACKREST_REPO2_PATH=/districom
# PGBACKREST_REPO2_S3_BUCKET=
# PGBACKREST_REPO2_S3_ENDPOINT=          # R2: <account-id>.r2.cloudflarestorage.com
# PGBACKREST_REPO2_S3_REGION=auto        # R2: auto
# PGBACKREST_REPO2_S3_URI_STYLE=path
# PGBACKREST_REPO2_S3_KEY=
# PGBACKREST_REPO2_S3_KEY_SECRET=
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO2_CIPHER_PASS=
# Weekly fulls kept 90 days: point-in-time restore to any minute of the last 90 days from off-site.
# PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
# PGBACKREST_REPO2_RETENTION_FULL=90
