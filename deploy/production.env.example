# DistriCom server: copy to `.env` at the repository root of the server (deploy/bin/init-env does it and
# generates the secrets). Never commit it. Secrets of the backups, the off-site bucket and the DNS API live in
# their own files (deploy/pgbackrest.env, deploy/offsite.env, deploy/caddy.env), read only by the service that
# needs them. Values marked PENDING depend on decisions for S3 (domain, hardware, providers).

# --- Application (same variables as .env.example) ---
APP_ENV=production
LOG_LEVEL=INFO
POSTGRES_USER=districom
POSTGRES_PASSWORD=
POSTGRES_DB=districom
# Inside the stack the backend reaches the database by service name; docker-compose.yml builds DATABASE_URL.
SECRET_KEY=
COOKIE_SECURE=true
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
CORS_ORIGINS=
UPLOAD_MAX_SIZE_MB=25
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# --- Name and certificate (PENDING: domain) ---
# One name for the LAN and for Tailscale, e.g. districom.example.com.ar. Never a .local name (mDNS).
DISTRICOM_HOST=districom.example.invalid
# cloudflare = public certificate by DNS-01 (needs deploy/caddy.env) · internal = Caddy's own CA (tests)
CADDY_TLS_MODE=internal
# Let's Encrypt production; for a first try use https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CADDY_MAX_BODY=30MB

# --- Network of the server (PENDING: hardware and router) ---
# Subnet of the office LAN: the only one, besides Tailscale, allowed to reach ports 80/443 (deploy/host/firewall.sh).
LAN_SUBNET=192.168.1.0/24
LAN_SERVER_IP=192.168.1.10
# Tailscale address of the server (100.x.y.z), known after `tailscale up`.
TAILSCALE_SERVER_IP=
CADDY_BIND_IP=0.0.0.0
DOCKER_SUBNET=172.30.0.0/24
CADDY_INTERNAL_IP=172.30.0.10

# --- Optional split DNS (compose profile "dns"; COMPOSE_PROFILES=dns to enable it) ---
COMPOSE_PROFILES=
DNS_LAN_BIND_IP=192.168.1.10
DNS_TAILSCALE_BIND_IP=
DNS_UPSTREAM=1.1.1.1 9.9.9.9

# --- Backups ---
# Mount point of the backup disk (separate from the system disks): pgbackrest/, dumps/, files/, state/.
BACKUP_ROOT=/srv/districom-backup
# Seconds after which PostgreSQL closes a WAL segment that has changes, so it is archived (RPO).
ARCHIVE_TIMEOUT_SECONDS=60
# Days of nightly logical dumps kept on the backup disk.
DUMP_RETENTION_DAYS=30

# --- Monitoring ---
# Command that receives an alert on stdin (mail, chat webhook...). Empty: alerts only go to the journal.
ALERT_COMMAND=
