# W2-C1: operations configuration of DistriCom on Windows (ADR 016, proposed).
# Copy to <root>\config\districom.env and fill in. Names only: never commit real values.
# `districom-ops check-config` validates it and reports problems without showing any value.

# Installation root (absolute path).
DISTRICOM_ROOT=C:\DistriCom
# Name the users open in the browser.
DISTRICOM_HOST=
# Application role, on 127.0.0.1 only; password of 16+ characters.
DATABASE_URL=
# Operations role (its own, never the application's), connecting to the "postgres" database (C9).
OPS_DATABASE_URL=
# Office LAN, private network of /16 or smaller (for example 192.168.1.0/24).
LAN_SUBNET=
# Minutes before an open maintenance window becomes an alert (default 60). Expiry never closes it.
MAINTENANCE_MAX_MINUTES=60
# Command that receives an alert on stdin (C8). Empty: alerts only go to the log.
ALERT_COMMAND=

# --- W2-C2: services (validated by the service commands) ---
# Backend session secret: 32+ random characters, without quotes.
SECRET_KEY=
# Root of the backup disk (for example D:\). Never the system disk nor the PostgreSQL data disk.
BACKUP_DISK_ROOT=
# Id printed once by `districom-ops backup-disk prepare`. The marker alone is not proof: the volume is checked too.
BACKUP_DISK_ID=
# Seconds the service stack waits for the backup disk at start before refusing (default 300; disks mount late).
BACKUP_DISK_WAIT_SECONDS=300
# PostgreSQL data folder (default <DISTRICOM_ROOT>\pgdata), on the system disk.
PG_DATA_DIR=
# Caddy ports (default 80 and 443). Change them only if another program on the server already uses them.
HTTP_PORT=
HTTPS_PORT=
