# Copiá este archivo a `.env` en la raíz del repo. Nunca commitees `.env`.

# --- Entorno ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Base de datos ---
POSTGRES_USER=districom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=districom
DATABASE_URL=postgresql+psycopg://districom:change-me@localhost:5432/districom
# Solo para tests de integración (base descartable, se migra desde cero).
TEST_DATABASE_URL=postgresql+psycopg://districom:change-me@localhost:5432/districom_test

# --- Seguridad ---
# obligatorio, mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true en producción (HTTPS)
COOKIE_SECURE=false
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
# la actividad de la sesión se guarda como mucho una vez cada tantos segundos (máximo 60)
SESSION_TOUCH_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# horas de validez de una contraseña temporal (reseteo o alta por un administrador)
TEMPORARY_PASSWORD_HOURS=72
# vacío en producción (mismo origen). Ej. dev: http://localhost:3000
CORS_ORIGINS=
# Orígenes que pueden enviar cambios además del propio (S2, verificación de `Origin`): el servidor de Next.js que
# reenvía /api/* al backend. Sin definir en development vale http://localhost:3000; vacío en producción (Caddy).
TRUSTED_ORIGINS=http://localhost:3000

# --- Importaciones ---
UPLOAD_MAX_SIZE_MB=25
# cuerpo máximo de un request de la API (JSON), en bytes reales; los archivos usan UPLOAD_MAX_SIZE_MB
REQUEST_MAX_BODY_BYTES=1048576

# --- Límites de las conexiones del backend a PostgreSQL (no afectan migrate, backups ni restores) ---
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Negocio ---
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# --- Frontend ---
# adonde Next.js reenvía /api/*
API_INTERNAL_URL=http://localhost:8000
