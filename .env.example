# Copiá este archivo a `.env` en la raíz del repo. Nunca commitees `.env`.

# --- Entorno ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Base de datos ---
POSTGRES_USER=districom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=districom
DATABASE_URL=postgresql+psycopg://districom:change-me@localhost:5432/districom
# Solo para tests de integración (base descartable, se migra desde cero).
TEST_DATABASE_URL=postgresql+psycopg://districom:change-me@localhost:5432/districom_test

# --- Seguridad ---
# obligatorio, mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true en producción (HTTPS)
COOKIE_SECURE=false
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7
# la actividad de la sesión se guarda como mucho una vez cada tantos segundos (máximo 60)
SESSION_TOUCH_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# vacío en producción (mismo origen). Ej. dev: http://localhost:3000
CORS_ORIGINS=

# --- Importaciones ---
UPLOAD_MAX_SIZE_MB=25

# --- Negocio ---
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# --- Frontend ---
# adonde Next.js reenvía /api/*
API_INTERNAL_URL=http://localhost:8000
